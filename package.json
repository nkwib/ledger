{
	"name": "@nkwib/ledger",
	"version": "0.1.0",
	"description": "Verifiable offline ledger substrate: per-device signed hash chains that merge deterministically, with typed conflict flags. Zero dependencies, isomorphic, WebCrypto only.",
	"license": "MIT",
	"author": "Gabriele Magno",
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nkwib/ledger.git"
	},
	"homepage": "https://github.com/nkwib/ledger#readme",
	"bugs": "https://github.com/nkwib/ledger/issues",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"production": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"docs",
		"examples",
		"README.md",
		"CHANGELOG.md",
		"SECURITY.md",
		"LICENSE"
	],
	"keywords": [
		"ledger",
		"hash-chain",
		"tamper-evident",
		"ecdsa",
		"signatures",
		"crdt",
		"merge",
		"local-first",
		"offline-first",
		"webcrypto",
		"audit-log"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"prepublishOnly": "pnpm build"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
